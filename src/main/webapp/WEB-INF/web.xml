<?xml version="1.0" encoding="UTF-8"?>
<web-app>
	<!--
		컨테이너 인증(FORM + security-constraint)은 제거함.
		이 프로젝트의 로그인은 member/processLoginMember.jsp 에서
		session의 "sessionId" 속성으로 처리하는 애플리케이션 레벨 인증이므로,
		톰캣 컨테이너는 로그인 상태를 알 수 없어 관리자 페이지 접근 시
		무조건 로그인 폼으로 되돌려 보내는 문제가 있었다.
		관리자 권한 체크는 각 JSP 상단의 sessionId 검사로 수행한다.
	-->

	<error-page>
	    <error-code>404</error-code>
	    <location>/exceptionNoPage.jsp</location>
	</error-page>
	
	<servlet>
		<servlet-name>BoardController</servlet-name>
		<servlet-class>mvc.controller.BoardController</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>BoardController</servlet-name>
		<url-pattern>*.do</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>AiChatController</servlet-name>
		<servlet-class>mvc.controller.AiChatController</servlet-class>
	</servlet>
	<servlet-mapping>
		<servlet-name>AiChatController</servlet-name>
		<url-pattern>/AiChatAction.do</url-pattern>
	</servlet-mapping>
</web-app>
